<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Soft Home Appliances & More</title><link rel="stylesheet" href="/style.css"></head><body><div class="rainbow"></div><header><div class="nav"><a class="brand" href="/">Soft Home <span>Appliances</span> & More</a><nav><a href="/">Home</a><a href="/admin/login">Admin</a></nav></div></header><section class="hero"><div class="hero-inner"><h1>Comfort for every home.</h1><p>Discover quality home appliances and useful products from Soft Home Appliances & More. Browse our products and contact us on WhatsApp for enquiries.</p><a class="btn" href="#products">Shop products</a></div></section><main class="container" id="products"><h2>Our Products</h2><div class="toolbar"><input id="search" placeholder="Search products..."><select id="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></div><div class="grid"><% products.forEach(p=>{ %><article class="card" data-product-card data-name="<%= p.name.toLowerCase() %>" data-description="<%= p.description.toLowerCase() %>" data-category="<%= p.category %>"><a href="/product/<%= p.id %>"><img src="/uploads/<%= p.image %>" alt="<%= p.name %>"></a><div class="card-body"><span class="category"><%= p.category %></span><h3><a href="/product/<%= p.id %>"><%= p.name %></a></h3><p class="muted"><%= p.description.length>110?p.description.slice(0,110)+'…':p.description %></p><div class="price"><%= p.price || 'Contact us for price' %></div><a class="btn green" href="https://wa.me/<%= whatsapp %>?text=<%= encodeURIComponent('Hello Soft Home Appliances, I am interested in '+p.name) %>">WhatsApp</a></div></article><% }) %></div><% if(!products.length){ %><div class="panel"><h3>No products yet</h3><p class="muted">The administrator can add products from the private dashboard.</p></div><% } %></main><footer><div class="footer-inner"><strong>Soft Home Appliances & More</strong><p>Quality products for your home.</p><p>WhatsApp: +256 743 537 202</p></div></footer><script src="/app.js"></script></body></html>
