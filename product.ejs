<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= product.name %> | Soft Home Appliances</title><link rel="stylesheet" href="/style.css"></head><body><div class="rainbow"></div><header><div class="nav"><a class="brand" href="/">Soft Home <span>Appliances</span> & More</a><nav><a href="/">Home</a></nav></div></header><main class="container"><a class="muted" href="/">← Back to products</a><div class="product-detail" style="margin-top:25px"><div><img src="/uploads/<%= product.image %>" alt="<%= product.name %>"></div><div><span class="category"><%= product.category %></span><h1><%= product.name %></h1><div class="price"><%= product.price || 'Contact us for price' %></div><p class="muted" style="white-space:pre-line"><%= product.description %></p><a class="wa" href="https://wa.me/<%= whatsapp %>?text=<%= encodeURIComponent('Hello Soft Home Appliances, I am interested in '+product.name) %>">Ask about this product on WhatsApp</a></div></div></main></body></html>
