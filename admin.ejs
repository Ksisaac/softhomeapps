<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard | Soft Home Appliances</title><link rel="stylesheet" href="/style.css"></head><body><div class="rainbow"></div><main class="admin-wrap"><div class="admin-head"><div><h1>Administrator Dashboard</h1><p class="muted">Signed in as <%= adminEmail %></p></div><div><a class="btn secondary" href="/">View website</a> <a class="btn" href="/admin/change-password">Change password</a><form method="post" action="/admin/logout" style="display:inline"><button class="btn" type="submit">Log out</button></form></div></div><% if(message){ %><div class="success"><%= message %></div><% } %><section class="panel"><h2>Add new product</h2><form method="post" action="/admin/products" enctype="multipart/form-data"><div class="form-grid"><div><label>Product name</label><input name="name" required placeholder="e.g. Electric Kettle"></div><div><label>Category</label><input name="category" required placeholder="Kitchen Appliances"></div><div><label>Price</label><input name="price" placeholder="e.g. UGX 85,000"></div><div><label>Product image</label><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required></div><div class="full"><label>Description</label><textarea name="description" rows="5" placeholder="Describe the product..."></textarea></div></div><button class="btn" type="submit">Upload product</button></form></section><section class="panel"><h2>Products (<%= products.length %>)</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Image</th><th>Product</th><th>Category</th><th>Price</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><img class="thumb" src="/uploads/<%= p.image %>" alt=""></td><td><strong><%= p.name %></strong><br><small><%= p.description %></small></td><td><%= p.category %></td><td><%= p.price %></td><td><details><summary>Edit</summary><form method="post" action="/admin/products/<%= p.id %>/update" enctype="multipart/form-data"><p><label>Name</label><input name="name" value="<%= p.name %>" required></p><p><label>Category</label><input name="category" value="<%= p.category %>" required></p><p><label>Price</label><input name="price" value="<%= p.price %>"></p><p><label>Description</label><textarea name="description" rows="4"><%= p.description %></textarea></p><p><label>Replace image (optional)</label><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"></p><button class="btn" type="submit">Save changes</button></form></details><form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?')" style="margin-top:8px"><button class="btn secondary" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div></section></main></body></html>
